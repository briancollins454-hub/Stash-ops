{
  "name": "stash-ops-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Unified orchestration backend for Stash Ops",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@prisma/client": "^6.9.0",
    "bullmq": "^5.56.1",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.8.2",
    "nodemailer": "^8.0.4",
    "pino": "^10.1.0",
    "prisma": "^6.9.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/nodemailer": "^7.0.11",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
