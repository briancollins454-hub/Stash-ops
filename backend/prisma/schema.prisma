generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Source & lifecycle enums ──

enum JobSource {
  SHOPIFY
  MANUAL
  DECO
}

enum MainLifecycle {
  INGESTED
  CLASSIFIED
  CONFIGURED
  PUSHED_TO_DECO
  AWAITING_STOCK
  STOCK_RECEIVED
  PRODUCTION_QUEUED
  IN_PRODUCTION
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ClassificationStatus {
  UNCLASSIFIED
  ACCOUNT_MATCHED
  ACCOUNT_REVIEW_NEEDED
  ASSET_REVIEW_NEEDED
  RULE_REVIEW_NEEDED
  METHOD_REVIEW_NEEDED
  CLASSIFIED_READY
}

enum ConfigurationStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_CONFIRMATION
  CONFIRMED
  PUSHED_TO_DECO
  DECO_PUSH_FAILED
}

enum StockStatus {
  NOT_REQUIRED
  AWAITING_ORDER
  ORDERED
  AWAITING_ARRIVAL
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  STOCK_ISSUE
}

enum ProductionStatus {
  NOT_READY
  QUEUED_EMBROIDERY
  QUEUED_DTF
  QUEUED_MIXED
  IN_EMBROIDERY
  IN_DTF
  IN_MIXED
  QC
  READY_FOR_DISPATCH
  COMPLETE
}

enum ApprovalStatus {
  NOT_REQUIRED
  AWAITING_ARTWORK
  PROOF_IN_PROGRESS
  PROOF_SENT
  AWAITING_CUSTOMER_APPROVAL
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum ProductionDepartment {
  EMBROIDERY
  DTF
  MIXED
}

enum Urgency {
  NORMAL
  RUSH
  CRITICAL
}

// ── Fulfillment ──

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RESTOCKED
}

// ── External & event enums ──

enum ExternalProvider {
  SHOPIFY_ORDER
  SHOPIFY_FULFILLMENT
  DECO_ORDER
  DECO_CUSTOMER
  GMAIL_THREAD
  SLACK_CHANNEL
  SHIPSTATION_LABEL
}

enum EventProvider {
  SHOPIFY
  DECO
  GMAIL
  SLACK
  MANUAL
  SYSTEM
}

enum EventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

// ── Account enums ──

enum AccountType {
  SCHOOL
  CLUB
  CLIENT
  OTHER
}

enum MatchStatus {
  AUTO_MATCHED
  MANUAL_MATCHED
  REVIEW_REQUIRED
  UNMATCHED
}

enum AssetType {
  LOGO
  TEMPLATE
  DESIGN_REFERENCE
  PROOF
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  SUPERSEDED
}

enum ProductMatcherType {
  ANY
  SKU_EXACT
  SKU_PREFIX
  SKU_CONTAINS
  TITLE_CONTAINS
  TAG_CONTAINS
  METAFIELD_EQUALS
}

// ── Communication enums ──

enum CommunicationChannel {
  GMAIL
  SLACK
  INTERNAL_NOTE
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

// ── Core models ──

model Job {
  id                    String               @id @default(cuid())
  internalJobId         String               @unique
  source                JobSource

  // Main lifecycle + sub-statuses
  lifecycle             MainLifecycle        @default(INGESTED)
  classificationStatus  ClassificationStatus @default(UNCLASSIFIED)
  configurationStatus   ConfigurationStatus  @default(NOT_STARTED)
  stockStatus           StockStatus          @default(NOT_REQUIRED)
  productionStatus      ProductionStatus     @default(NOT_READY)
  approvalStatus        ApprovalStatus       @default(NOT_REQUIRED)
  fulfillmentStatus     FulfillmentStatus    @default(UNFULFILLED)
  assignedDepartment    ProductionDepartment?

  // External references
  shopifyOrderId        String?
  shopifyOrderName      String?
  decoOrderId           String?
  shopifyCustomerId     String?
  decoCustomerId        String?

  // Account context
  accountId             String?
  accountMatchStatus    MatchStatus          @default(UNMATCHED)
  accountMatchScore     Int?
  accountMatchReason    String?

  // Review / blocking
  requiresReview        Boolean              @default(false)
  reviewReason          String?
  blockedReason         String?

  // Customer context
  customerName          String?
  customerEmail         String?
  customerCompany       String?
  customerPhone         String?
  schoolName            String?
  clubName              String?
  leaversYear           String?

  // Commercial
  currencyCode          String               @default("GBP")
  subtotalMinor         Int?
  totalMinor            Int                  @default(0)
  urgency               Urgency              @default(NORMAL)
  orderPlacedAt         DateTime?
  dueAt                 DateTime?
  owner                 String?
  tags                  String[]             @default([])
  orderNotes            String?

  // Source group (school/club/company grouping)
  sourceGroupKey        String?
  sourceGroupLabel      String?
  sourceGroupType       String?

  // Metadata snapshots
  shopifyMetadata       Json?
  preconfiguration      Json?
  preconfiguredAt       DateTime?

  // Deco push context
  pushToDecoStatus      String?
  lastDecoPushAt        DateTime?
  decoPushErrors        String?

  // Artwork / proof
  proofVersion          String?
  proofSentAt           DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  approvalNotes         String?

  // Production
  productionStartedAt   DateTime?
  productionCompletedAt DateTime?
  productionNotes       String?

  metadata              Json?

  // Relations
  items                 JobItem[]
  externalLinks         ExternalLink[]
  stockRequirements     JobStockRequirement[]
  warehouseReceipts     WarehouseReceipt[]
  communications        Communication[]
  activityLogs          ActivityLog[]
  account               Account?             @relation(fields: [accountId], references: [id], onDelete: SetNull)

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([lifecycle])
  @@index([classificationStatus])
  @@index([configurationStatus])
  @@index([stockStatus])
  @@index([productionStatus])
  @@index([approvalStatus])
  @@index([fulfillmentStatus])
  @@index([assignedDepartment])
  @@index([shopifyOrderId])
  @@index([decoOrderId])
  @@index([accountId])
  @@index([accountMatchStatus])
  @@index([requiresReview])
  @@index([sourceGroupKey])
  @@index([dueAt])
  @@index([urgency])
}

model JobItem {
  id                  String    @id @default(cuid())
  jobId               String
  externalLineId      String?
  sku                 String?
  productTitle        String
  variantTitle        String?
  quantity            Int
  unitPriceMinor      Int?
  totalPriceMinor     Int?
  garmentReference    String?
  decorationMethod    String?
  decorationPlacement String?

  // Preconfiguration recommendation
  matchedRuleId       String?
  matchedAssetId      String?
  matchedPlacementId  String?
  recommendedMethod   String?
  recommendationScore Int?
  lineReviewRequired  Boolean   @default(false)
  lineReviewReasons   String[]  @default([])

  customOptions       Json?
  metadata            Json?

  job                 Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stockRequirement    JobStockRequirement?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([jobId])
  @@index([sku])
}

model JobStockRequirement {
  id                String      @id @default(cuid())
  jobId             String
  jobItemId         String      @unique
  requiredQuantity  Int
  receivedQuantity  Int         @default(0)
  status            StockStatus @default(AWAITING_ORDER)

  supplierName      String?
  supplierReference String?
  supplierNotes     String?
  eta               DateTime?

  isBlocking        Boolean     @default(true)
  shortageFlag      Boolean     @default(false)

  job               Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobItem           JobItem     @relation(fields: [jobItemId], references: [id], onDelete: Cascade)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([jobId])
  @@index([status])
}

model WarehouseReceipt {
  id              String               @id @default(cuid())
  jobId           String
  receivedBy      String
  branch          String               @default("HQ")
  isPartial       Boolean              @default(true)
  totalReceived   Int                  @default(0)
  notes           String?
  receivedAt      DateTime             @default(now())

  scanEvents      WarehouseScanEvent[]
  job             Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt       DateTime             @default(now())

  @@index([jobId])
  @@index([receivedAt])
}

model WarehouseScanEvent {
  id              String           @id @default(cuid())
  receiptId       String
  sku             String
  barcode         String?
  quantity        Int
  scannedBy       String
  location        String?
  scannedAt       DateTime         @default(now())

  receipt         WarehouseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([sku])
}

model Communication {
  id                  String                 @id @default(cuid())
  jobId               String
  channel             CommunicationChannel
  direction           CommunicationDirection
  subject             String
  bodyPreview         String?
  bodyHtml            String?
  providerMessageId   String?
  providerThreadId    String?
  attachments         Json                   @default("[]")
  sentBy              String?
  sentAt              DateTime?
  createdAt           DateTime               @default(now())

  job                 Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([channel])
  @@index([providerThreadId])
}

model ExternalLink {
  id         String           @id @default(cuid())
  jobId      String
  provider   ExternalProvider
  externalId String
  metadata   Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  job        Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([jobId])
}

model EventInbox {
  id             String        @id @default(cuid())
  provider       EventProvider
  topic          String
  externalId     String?
  idempotencyKey String        @unique
  payload        Json
  status         EventStatus   @default(RECEIVED)
  errorMessage   String?
  receivedAt     DateTime      @default(now())
  processedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([provider, topic])
  @@index([status, receivedAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  jobId     String
  eventType String
  message   String
  payload   Json?
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model SyncCursor {
  id        String   @id @default(cuid())
  provider  String   @unique
  cursor    String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Account models ──

model Account {
  id                      String                   @id @default(cuid())
  key                     String                   @unique
  name                    String
  type                    AccountType              @default(CLIENT)
  active                  Boolean                  @default(true)
  decoCustomerId          String?
  shopifyCustomerIds      String[]                 @default([])
  defaultDecorationMethod String?
  defaultProductionNotes  String?
  notes                   String?
  metadata                Json?
  aliases                 AccountAlias[]
  assets                  AccountAsset[]
  placementConfigs        AccountPlacementConfig[]
  productRules            AccountProductRule[]
  jobs                    Job[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([name])
  @@index([decoCustomerId])
  @@index([type])
}

model AccountAlias {
  id              String   @id @default(cuid())
  accountId       String
  aliasRaw        String
  aliasNormalized String
  source          String   @default("manual")
  weight          Int      @default(100)
  active          Boolean  @default(true)
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([accountId, aliasNormalized])
  @@index([aliasNormalized])
}

model AccountAsset {
  id               String              @id @default(cuid())
  accountId        String
  assetType        AssetType
  assetStatus      AssetStatus         @default(ACTIVE)
  label            String
  decoDesignId     String?
  decoTemplateId   String?
  fileUrl          String?
  colorway         String?
  decorationMethod String?
  isDefault        Boolean             @default(false)
  priority         Int                 @default(100)
  active           Boolean             @default(true)
  metadata         Json?
  account          Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productRules     AccountProductRule[] @relation("RuleAsset")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([accountId, assetType, active])
  @@index([assetStatus])
}

model AccountPlacementConfig {
  id               String               @id @default(cuid())
  accountId        String
  label            String
  placementKey     String
  decorationMethod String?
  widthMm          Float?
  heightMm         Float?
  offsetXMm        Float?
  offsetYMm        Float?
  rotationDegrees  Float?
  priority         Int                  @default(100)
  active           Boolean              @default(true)
  metadata         Json?
  account          Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productRules     AccountProductRule[] @relation("RulePlacement")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([accountId, placementKey, active])
}

model AccountProductRule {
  id                String                  @id @default(cuid())
  accountId         String
  matcherType       ProductMatcherType
  matcherKey        String?
  matcherValue      String
  priority          Int                     @default(100)
  decorationMethod  String?
  templateAssetId   String?
  placementConfigId String?
  requireReview     Boolean                 @default(false)
  active            Boolean                 @default(true)
  metadata          Json?
  account           Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  templateAsset     AccountAsset?           @relation("RuleAsset", fields: [templateAssetId], references: [id], onDelete: SetNull)
  placementConfig   AccountPlacementConfig? @relation("RulePlacement", fields: [placementConfigId], references: [id], onDelete: SetNull)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([accountId, priority, active])
}

// ── Deco catalog models ──

model DecoCustomer {
  id              String   @id @default(cuid())
  decoCustomerId  String   @unique
  name            String
  email           String?
  phone           String?
  company         String?
  address1        String?
  address2        String?
  city            String?
  state           String?
  postcode        String?
  country         String?
  active          Boolean  @default(true)
  metadata        Json?
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
  @@index([email])
  @@index([company])
}

model DecoProduct {
  id             String          @id @default(cuid())
  decoProductId  String          @unique
  name           String
  sku            String?
  category       String?
  price          Float?
  sizes          String?
  colors         String?
  active         Boolean         @default(true)
  metadata       Json?
  lastSyncedAt   DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventory      DecoInventory[]

  @@index([sku])
  @@index([name])
  @@index([category])
}

model DecoInventory {
  id               String      @id @default(cuid())
  decoProductId    String
  sku              String?
  productName      String?
  quantityOnHand   Int         @default(0)
  quantityAvailable Int        @default(0)
  quantityOnOrder  Int         @default(0)
  lastSyncedAt     DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  product          DecoProduct? @relation(fields: [decoProductId], references: [decoProductId], onDelete: Cascade)

  @@unique([decoProductId])
  @@index([sku])
}

// ── Ralawise Product Catalog (imported from CSV feed) ──

model CatalogProduct {
  id                String          @id @default(cuid())
  styleCode         String          @unique       // e.g. "JH030"
  manufacturerCode  String?                       // Manufacturer Style Code
  brand             String                        // e.g. "AWDis Just Hoods"
  name              String                        // e.g. "AWDis sweatshirt"
  productType       String?                       // e.g. "Sweatshirts"
  gender            String?                       // Male / Female / Unisex
  ageGroup          String?                       // Adult / Junior
  fabric            String?                       // e.g. "80% Ringspun Cotton..."
  weight            String?                       // GSM value(s)
  sizeRange         String?                       // e.g. "S to 3XL"
  specification     String?                       // Full spec text
  retailDescription String?                       // Marketing description
  primaryImageUrl   String?                       // Lifestyle image URL
  categorisation    String?                       // Pipe-separated categories
  accreditations    String?                       // e.g. "WRAP|Oeko-Tex"
  tag               String?                       // e.g. "Tagless"
  sustainable       String?                       // Yes/No
  printArea         String?
  embroideryInfo    String?
  sizeGuideUrl      String?
  specSheetUrl      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  colours           CatalogColour[]

  @@index([brand])
  @@index([productType])
}

model CatalogColour {
  id              String          @id @default(cuid())
  styleCode       String                          // FK to CatalogProduct
  colourCode      String                          // e.g. "BLAC"
  colourName      String                          // e.g. "Black"
  imageUrl        String?                         // Colour-specific front image
  backImageUrl    String?                         // Back view image URL
  sideImageUrl    String?                         // Side view image URL
  modelImageUrl   String?                         // Model/lifestyle image URL
  detailImageUrl  String?                         // Detail/closeup image URL
  rgb             String?                         // e.g. "51 51 51"
  pantone         String?                         // e.g. "Black (Black)"
  cmyk            String?                         // e.g. "0 0 0 100 (Black)"
  primaryColour   String?                         // e.g. "Black"
  colourShade     String?                         // e.g. "Black - Black"
  cartonPrice     String?
  packPrice       String?
  singlePrice     String?
  cartonQty       String?
  packQty         String?
  skuStatus       String?                         // "Live" / "Discontinued"
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  product         CatalogProduct  @relation(fields: [styleCode], references: [styleCode], onDelete: Cascade)

  @@unique([styleCode, colourCode])
  @@index([styleCode])
  @@index([colourName])
}
