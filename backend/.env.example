NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Public URL of this backend (for Shopify webhook auto-registration)
# e.g. https://stash-api.up.railway.app
PUBLIC_URL=

FRONTEND_ORIGIN=https://your-vercel-app.vercel.app

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stash_ops
REDIS_URL=redis://localhost:6379

# ── Shopify ──
SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=shopify_webhook_signing_secret
SHOPIFY_SYNC_MAX_PAGES=40
SHOPIFY_SYNC_PAGE_SIZE=100

# ── DecoNetwork ──
DECO_BASE_URL=https://your-instance.secure-decoration.com
DECO_USERNAME=your_deco_username
DECO_PASSWORD=your_deco_password
DECO_WEBHOOK_SECRET=
DECO_SYNC_TIMEOUT_MS=25000
