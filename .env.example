ENABLE_DEMO_DATA=false
BACKEND_API_URL=https://your-railway-api-domain.up.railway.app
INTERNAL_BACKEND_API_URL=

# Persistence
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# Shopify
SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_admin_api_token
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret
SHOPIFY_API_SECRET=your_shopify_app_secret
SHOPIFY_SYNC_MAX_PAGES=20
SHOPIFY_BACKFILL_MAX_PAGES=250
SHOPIFY_SYNC_TIMEOUT_MS=30000

# Sync engine safety valve (unlocks stale provider workers)
SYNC_PROVIDER_MAX_RUNTIME_MS=900000

# Deco bridge
DECO_ORDER_UPSERT_URL=https://your-internal-deco-bridge.example.com/upsert
DECO_UPSERT_TOKEN=
DECO_UPSERT_TOKEN_HEADER=authorization
DECO_UPSERT_TOKEN_PREFIX=Bearer
DECO_SYNC_TIMEOUT_MS=25000

# ShipStation bridge
SHIPSTATION_PRINT_URL=https://your-internal-shipstation-bridge.example.com/print
SHIPSTATION_PRINT_TOKEN=
SHIPSTATION_PRINT_TOKEN_HEADER=authorization
SHIPSTATION_PRINT_TOKEN_PREFIX=Bearer

# QuickBooks Online
QBO_REALM_ID=
QBO_ACCESS_TOKEN=
QBO_MINOR_VERSION=75
QBO_BASE_URL=https://quickbooks.api.intuit.com

# Gmail
GMAIL_ACCESS_TOKEN=
GMAIL_USER_ID=me
GMAIL_SYNC_MAX_RESULTS=40

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=
SLACK_SYNC_MAX_PER_CHANNEL=50
